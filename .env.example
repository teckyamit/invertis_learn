# ==============================================================================
# Invertis Learn — Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before starting the application:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Prisma ORM)
# ------------------------------------------------------------------------------
# Default provider is SQLite. Relative paths resolve relative to prisma/schema.prisma.
# For production PostgreSQL / MySQL migration, update prisma/schema.prisma datasource provider.
DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. File and PDF Storage Path
# ------------------------------------------------------------------------------
# Persistent directory on disk for uploaded academic resources and syllabi.
# Recommended to place OUTSIDE public web root for security.
# Relative to repository root in development:
PRIVATE_STORAGE_PATH="./storage/uploads"

# ------------------------------------------------------------------------------
# 3. Curator / Admin Authentication Secret
# ------------------------------------------------------------------------------
# Secret key used for signing curator session cookies and authenticating upload APIs.
# MUST be at least 32 characters long.
# Run `npm run curator:setup` to generate a cryptographically secure 64-char key automatically.
CURATOR_ACCESS_KEY="replace-with-at-least-32-char-random-secret-key-here"

# ------------------------------------------------------------------------------
# 4. Application Origin (CSRF and CORS Protection)
# ------------------------------------------------------------------------------
# Exact browser origin used for CSRF origin verification in production.
# Example: https://invertislearn.example.com (NO trailing slash).
# Leave blank during local development to dynamically trust incoming localhost origin.
APP_ORIGIN=""

# ------------------------------------------------------------------------------
# 5. Node Environment (Managed automatically by Next.js)
# ------------------------------------------------------------------------------
# NODE_ENV="development" # or "production"
