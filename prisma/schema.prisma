// Invertis Learn Database Schema
// Phase 1: Syllabus Library Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Department {
  id          String      @id @default(cuid())
  code        String      @unique // e.g. "ENG", "CA", "MGMT"
  name        String      // e.g. "Faculty of Engineering & Technology"
  facultyDean String?
  description String?
  isActive    Boolean     @default(true)
  programmes  Programme[]
  users       User[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Programme {
  id                  String              @id @default(cuid())
  departmentId        String
  department          Department          @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  code                String              @unique // e.g. "BTECH-CSE", "MTECH-CSE"
  name                String              // e.g. "Bachelor of Technology in Computer Science & Engineering"
  degreeLevel         String              @default("UNDERGRADUATE") // UNDERGRADUATE, POSTGRADUATE, DIPLOMA, DOCTORAL
  category            String              @default("UNDERGRADUATE") // UNDERGRADUATE, POSTGRADUATE, DIPLOMA, DOCTORAL
  durationYears       Int                 @default(4)
  eligibility         String?
  specializations     String?             // JSON or comma-separated
  description         String?
  careerProspects     String?
  officialSourceUrl   String?
  hasOfficialSyllabus Boolean             @default(false)
  isLateralEntry      Boolean             @default(false)
  isActive            Boolean             @default(true)
  curriculumVersions  CurriculumVersion[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
}

model CurriculumVersion {
  id             String      @id @default(cuid())
  programmeId    String
  programme      Programme   @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  versionYear    String      // e.g. "2023-2024"
  regulationName String?     // e.g. "Session 2023-24 Regulation"
  isCurrent      Boolean     @default(true)
  description    String?
  semesters      Semester[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@unique([programmeId, versionYear])
}

model Semester {
  id                  String            @id @default(cuid())
  curriculumVersionId String
  curriculumVersion   CurriculumVersion @relation(fields: [curriculumVersionId], references: [id], onDelete: Cascade)
  semesterNumber      Int               // 1 to 8
  title               String            // "Semester I", "Semester II", etc.
  subjects            Subject[]

  @@unique([curriculumVersionId, semesterNumber])
}

model Subject {
  id              String             @id @default(cuid())
  semesterId      String
  semester        Semester           @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  code            String             // e.g. "BCS-301"
  name            String             // e.g. "Data Structures"
  lectureHours    Int                @default(3)
  tutorialHours   Int                @default(1)
  practicalHours  Int                @default(0)
  credits         Float              @default(3.0)
  subjectType     String             @default("THEORY") // THEORY, PRACTICAL, MANDATORY, PROJECT, SEMINAR
  electiveGroup   String?            // e.g. "Elective-I", "Open Elective-II" (null for core)
  evaluationMarks String?            // e.g. "CA: 25, EE: 50, Total: 75"
  syllabusDetails String?            // JSON: { objectives, outcomes, modules, textBooks, referenceBooks, labExperiments }
  isActive        Boolean            @default(true)
  resources       AcademicResource[]
  externalResources ExternalResource[]
  videoLectures     VideoLecture[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([semesterId, code])
}

model ResourceCategory {
  id          String             @id @default(cuid())
  code        String             @unique // "SYLLABUS", "PYQ", "NOTES", "LAB_MANUAL"
  name        String             // "Official Syllabus", "Previous-Year Paper"
  description String?
  resources   AcademicResource[]
}

model AcademicResource {
  id               String            @id @default(cuid())
  subjectId        String
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  categoryId       String
  category         ResourceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  title            String            // e.g. "Official Syllabus - B.Tech CSE Sem 3"
  originalFileName String
  storedFileName   String
  storagePath      String            // Relative path in storage directory
  mimeType         String            @default("application/pdf")
  fileSizeBytes    Int
  versionNumber    Int               @default(1)
  academicYear     String?           // e.g. "2023-2024", "2022-2023"
  examType         String?           // "END_SEMESTER", "MID_SEMESTER", "BACK_PAPER"
  hasSolutions     Boolean           @default(false)
  unitNumber       Int?              // 1, 2, 3, etc. (for Unit-wise Notes)
  resourceType     String?           // "LECTURE_NOTES", "PPT_SLIDES", "UNIT_SUMMARY", "FORMULA_SHEET"
  authorName       String?           // Faculty / Instructor name or "Department Faculty"
  isPublished      Boolean           @default(true)
  provenanceStatus String            @default("UNVERIFIED") // UNVERIFIED, PRACTICE, VERIFIED
  sourceReference  String?
  reviewedBy       String?
  reviewedAt       DateTime?
  reviewNote       String?
  uploadedById     String?
  uploadedBy       User?             @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([subjectId, categoryId])
  @@index([categoryId, academicYear])
  @@index([categoryId, resourceType])
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  fullName     String
  role         String             @default("STUDENT") // SUPER_ADMIN, DEPARTMENT_ADMIN, FACULTY, STUDENT
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  isActive     Boolean            @default(true)
  resources    AcademicResource[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ExternalResource {
  id           String   @id @default(cuid())
  subjectId    String
  subject      Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title        String
  platform     String   // e.g. "NPTEL", "MIT OpenCourseWare", "GeeksforGeeks", "MDN Web Docs"
  url          String
  description  String
  category     String   // "Online Tutorials", "Official Documentation", "Free Online Courses", "Lecture Notes", "Programming Practice", "Reference Materials", "Useful Tools and Simulators"
  unitNumber   Int?     // 1, 2, 3, etc. or null
  topic        String?
  pricingType  String   @default("FREE") // "FREE", "FREEMIUM", "PAID"
  resourceType String   @default("TUTORIAL") // "DOCUMENTATION", "TUTORIAL", "COURSE", "PRACTICE", "SIMULATOR", "NOTES"
  isVerified   Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([subjectId, category])
  @@index([subjectId, unitNumber])
}

model VideoLecture {
  id          String   @id @default(cuid())
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  youtubeUrl  String
  youtubeId   String   // Video ID or Playlist ID
  videoType   String   @default("PLAYLIST") // "INDIVIDUAL_VIDEO" or "PLAYLIST"
  channelName String   // e.g. "NPTEL-NOC IITM", "MIT OpenCourseWare", "freeCodeCamp.org"
  unitNumber  Int?     // 1, 2, 3, etc. or null
  topic       String?
  description String
  pricingType String   @default("FREE")
  isVerified  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subjectId, unitNumber])
}

model AuditEvent {
  id        String   @id @default(cuid())
  action    String
  targetId  String?
  actor     String
  detail    String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
